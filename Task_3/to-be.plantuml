@startuml
!theme plain
left to right direction

skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam shadowing false
skinparam wrapWidth 180
skinparam maxMessageSize 180

skinparam rectangle {
  BorderColor #555555
  BackgroundColor #FFFFFF
}

skinparam component {
  BorderColor #555555
  BackgroundColor #F8F8F8
}

skinparam database {
  BorderColor #555555
  BackgroundColor #FFF4CC
}

skinparam queue {
  BorderColor #555555
  BackgroundColor #EAF4FF
}

actor "Клиент" as Customer
actor "Оператор\nподдержки" as Support
actor "Бизнес-\nпользователи" as BusinessUsers

cloud "Маркетплейсы" as Marketplaces
cloud "Платёжные\nпровайдеры" as PaymentProviders
cloud "Службы\nдоставки" as DeliveryPartners
cloud "Внутренние\nBI / отчёты" as BI

rectangle "RetailCore TO-BE — первый этап" as RetailCore {

  component "Интернет-магазин\nи мобильные каналы" as Channels

  package "Java-монолит\nсохраняемый критичный контур" as JavaMonolith {

    component "Checkout / Order API" as OrderApi

    component "Order Processing" as Processing

    component "Pricing & Promo Logic" as Pricing

    component "Status Management" as Statuses

    component "Payment Orchestration" as PaymentOrchestration

    component "Delivery Routing" as DeliveryRouting
  }

  database "Oracle\nоперационная БД + legacy бизнес-логика" as Oracle

  package "Новый контур первого этапа" as NewPlatform {

    queue "Order Event Bus\nканонические события заказа\nи доставки" as OrderEvents

    component "Order State Read Model\nтекущее состояние,\nистория и причины отклонений" as OrderReadModel

    database "Order Read Store\nмодель чтения состояния заказа" as OrderReadDb

    component "Integration Layer / ACL\nединый контракт,\nадаптация legacy-интеграций" as IntegrationLayer

    component "Analytics Ingestion\nобработка канонических событий" as AnalyticsIngestion

    database "Analytics Store\nданные для новых витрин" as AnalyticsStore
  }

  package "Вспомогательные сервисы" as AuxServices {

    component ".NET integration service\nlegacy партнёрские интеграции" as DotNet

    component "Python analytics jobs\nаналитические выгрузки" as PyAnalytics
  }

  queue "Async / batch exchange\nlegacy очереди, задания, выгрузки" as AsyncLayer

  component "Admin / Support tools\nручные проверки и корректировки" as AdminTools
}


' --------------------------------------------------
' Сохраняемый критичный order flow
' --------------------------------------------------

Customer --> Channels : оформление заказа,\nпросмотр статуса

Channels --> OrderApi : create/update order\nсинхронный вызов

Marketplaces --> OrderApi : заказы,\nобновления,\nстатусы

OrderApi --> Pricing : расчёт цены,\nскидок,\nпромо

OrderApi --> Processing : создание и обработка заказа

Processing --> PaymentOrchestration : инициировать оплату

Processing --> DeliveryRouting : выбрать доставку

PaymentOrchestration --> PaymentProviders : синхронный вызов\nсоздания платёжной сессии

Pricing --> Oracle : правила,\nкоэффициенты,\nlegacy promo logic

Processing --> Oracle : заказ,\nрезерв,\nслужебные таблицы

Statuses --> Oracle : статусы,\nистория,\nтехнические состояния

PaymentOrchestration --> Oracle : payment_session_id,\nтехнические атрибуты

DeliveryRouting --> Oracle : правила маршрутизации,\nпартнёры,\nretry-состояния


' --------------------------------------------------
' Точка трансформации 1:
' канонические события + read model
' --------------------------------------------------

Processing --> OrderEvents : события жизненного\nцикла заказа

Statuses --> OrderEvents : изменения состояния

OrderEvents --> OrderReadModel : канонические события

OrderReadModel --> OrderReadDb : обновляет\nмодель чтения

AdminTools --> OrderReadModel : состояние,\nистория,\nпричины отклонений

Support --> AdminTools : разбор обращений,\nручные действия


' --------------------------------------------------
' Точка трансформации 2:
' постепенная изоляция интеграций
' --------------------------------------------------

DeliveryRouting --> IntegrationLayer : запросы для\nпереведённых интеграций

IntegrationLayer --> DeliveryPartners : унифицированный\nконтракт / адаптер

IntegrationLayer --> OrderEvents : статусы и события\nпартнёров

AsyncLayer --> IntegrationLayer : legacy async /\nbatch вход

IntegrationLayer --> DotNet : временная поддержка\nlegacy-контрактов


' Legacy путь сохраняется для ещё не мигрированных интеграций

DeliveryRouting ..> DeliveryPartners : legacy интеграции\nвременно

AsyncLayer ..> DotNet : legacy обмен\nвременно

DotNet ..> Oracle : staging/shared tables\nвременно

DotNet ..> DeliveryPartners : legacy партнёрские\nинтеграции


' --------------------------------------------------
' Точка трансформации 3:
' аналитика вне операционной Oracle
' --------------------------------------------------

OrderEvents --> AnalyticsIngestion : события заказа\nи доставки

AnalyticsIngestion --> AnalyticsStore : нормализованные\nаналитические данные

PyAnalytics --> AnalyticsStore : новые и\nмигрированные пайплайны

PyAnalytics --> BI : витрины\nи отчётные данные

BusinessUsers --> BI : управленческие отчёты


' Legacy аналитика сохраняется на переходный период

PyAnalytics ..> Oracle : legacy выборки\nвременно

BI ..> Oracle : legacy отчёты\nвременно


' --------------------------------------------------
' Существующий legacy async
' --------------------------------------------------

Processing --> AsyncLayer : legacy события,\nзадания,\nвыгрузки


' --------------------------------------------------
' Пояснения
' --------------------------------------------------

note right of Processing
НЕ МЕНЯЕТСЯ НА ПЕРВОМ ЭТАПЕ

Core order create остаётся
в Java-монолите.

Не переносим:
- создание заказа
- основной pricing
- payment orchestration
- основную delivery routing

Причина:
высокий риск для order flow.
end note

note bottom of OrderEvents
ТОЧКА ТРАНСФОРМАЦИИ 1

Единый контракт событий
создаёт основу для:
- прослеживаемости
- read model
- аналитики
- дальнейшей декомпозиции

Гарантии доставки и
допустимая задержка — TBD.
end note

note bottom of OrderReadModel
Первый этап — read-only контур.

Операционным источником
записи остаются
монолит и Oracle.
end note

note right of IntegrationLayer
ТОЧКА ТРАНСФОРМАЦИИ 2

Интеграции переводятся
постепенно.

ACL:
- адаптирует legacy-контракты
- переводит статусы
- унифицирует технический обмен

Routing-решения здесь
не принимаются.
end note

note bottom of AnalyticsStore
ТОЧКА ТРАНСФОРМАЦИИ 3

Новые аналитические consumers
не должны создавать новую
зависимость от операционной Oracle.

Старые отчёты мигрируют
постепенно.
end note

note bottom of Oracle
СОХРАНЯЕТСЯ НА ПЕРВОМ ЭТАПЕ

Oracle остаётся:
- операционной БД
- носителем legacy-логики
- источником для ещё
  не мигрированных consumers

Полное разделение данных
в этот этап не входит.
end note

@enduml